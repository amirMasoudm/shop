# ============================================================
# قالب متغیرهای محیطی برای docker-compose
# این فایل را کپی کن به .env و مقادیر واقعی را جایگزین کن:
#     cp .env.example .env
# فایل .env هرگز نباید در گیت کامیت شود.
# ============================================================

# --- MongoDB ---
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# نامِ دیتابیس اپ. خالی/نبود = پیش‌فرضِ shopdb. برای سوییچ به نسخهٔ بازنویسی‌شده مقدارش را shopdb_v2 بگذار
# سپس فقط `docker compose up -d` (بدون --build). shopdb هرگز حذف/overwrite نمی‌شود؛ سوییچ فقط انتخابِ DB است.
MONGO_DB_NAME=shopdb

# --- SMS.ir ---
SMS_API_KEY=CHANGE_ME
SMS_TEMPLATE_ID=638829
# قالبِ «دوباره موجود شد» (متغیرِ PRODUCT)؛ خالی/نبود = پیش‌فرضِ 791445
SMS_STOCK_TEMPLATE_ID=791445

# --- External APIs ---
OPENAI_KEY=CHANGE_ME
TAPIN_TOKEN=CHANGE_ME
SNAPP_TOKEN=CHANGE_ME

# --- درگاهِ پرداختِ ملت (بهپرداخت) ---
# این سه مقدار را فقط مالک از پیامکِ اطلاعاتِ اتصالِ ملت اینجا می‌گذارد — چت الف این‌ها را نمی‌بیند.
MELLAT_TERMINAL_ID=CHANGE_ME
MELLAT_USERNAME=CHANGE_ME
MELLAT_PASSWORD=CHANGE_ME

# --- Initial Admin ---
ADMIN_USERNAME=superadmin
ADMIN_PHONE=09xxxxxxxxx
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Analytics ---
# شناسه GA4 مثل G-XXXXXXXXXX و کد تایید Search Console
GA4_ID=
GSC_VERIFICATION=
